        "source_math": [
          {
            "latex": "\\begin{aligned}\\min_{(x(\\cdot),u(\\cdot))\\in\\mathcal F}\\;&\\int_0^T\\big[q_1(x_1(\\tau)-x_1^{\\mathrm{des}}(\\tau))^2+q_2x_2(\\tau)^2+r(u(\\tau)-u^{\\mathrm{des}}(\\tau))^2\\big]d\\tau\\\\&+q_{T1}(x_1(T)-x_1^{\\mathrm{des}}(T))^2+q_{T2}x_2(T)^2\\\\\\text{subj.to }&\\dot x_1(t)=x_2(t)\\\\&\\dot x_2(t)=-\\frac{g}{l}\\sin x_1(t)+\\frac{1}{m\\ell^2}u(t)\\\\&x(0)=x^0\\end{aligned}",
            "anchor": "The optimal control problem then reads",
            "notes": "Fattori esattamente come nella fonte: nessun 1/2."
          },
          {
            "latex": "Q=\\begin{bmatrix}q_1&0\\\\0&q_2\\end{bmatrix},\\quad Q_T=\\begin{bmatrix}q_{T1}&0\\\\0&q_{T2}\\end{bmatrix},\\quad R=r",
            "anchor": "where we chose as weight matrices",
            "notes": "Trascrizione visiva della notazione sorgente; nessuna sostituzione di simboli."
          }
        ],
