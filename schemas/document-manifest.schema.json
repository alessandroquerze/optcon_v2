{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:optconv:document-manifest:1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "document_id", "source", "page_count", "metadata", "pdf_page_label_rules", "config", "created_at", "pages", "relation_groups", "coverage"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "document_id": {"type": "string", "minLength": 1},
    "source": {"type": "object", "additionalProperties": false, "required": ["path", "filename", "sha256", "size_bytes"],
      "properties": {"path": {"type": "string", "minLength": 1}, "filename": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "size_bytes": {"type": "integer", "minimum": 1}}},
    "page_count": {"type": "integer", "minimum": 1}, "metadata": {"type": "object"},
    "pdf_page_label_rules": {"type": "array", "items": {"type": "object"}},
    "created_at": {"type": "string", "minLength": 1},
    "config": {"type": "object", "additionalProperties": false,
      "required": ["pipeline_version", "dpi", "renderer", "pymupdf_version", "pillow_version", "relations_algorithm", "thresholds"],
      "properties": {"pipeline_version": {"type": "string"}, "dpi": {"type": "integer", "minimum": 72, "maximum": 300},
        "renderer": {"const": "PyMuPDF"}, "pymupdf_version": {"type": "string"}, "pillow_version": {"type": "string"},
        "relations_algorithm": {"type": "string"}, "thresholds": {"type": "object", "additionalProperties": {"type": "number"}}}},
    "pages": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false, "required": ["page_id", "physical_page_number", "pdf_label", "title", "spec_path"],
      "properties": {"page_id": {"type": "string", "minLength": 1}, "physical_page_number": {"type": "integer", "minimum": 1},
        "pdf_label": {"type": ["string", "null"]}, "title": {"type": ["string", "null"]}, "spec_path": {"type": "string", "minLength": 1}}
    }},
    "relation_groups": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["group_id", "page_ids", "status", "collapse_pages"],
      "properties": {"group_id": {"type": "string"}, "page_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
        "status": {"const": "candidate_cluster"}, "collapse_pages": {"const": false}}
    }},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["extracted_pages", "rendered_pages"],
      "properties": {"extracted_pages": {"type": "integer", "minimum": 1}, "rendered_pages": {"type": "integer", "minimum": 1}}}
  }
}
