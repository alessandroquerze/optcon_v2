{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:optconv:page-spec:1.0.0",
  "title": "PAGE_SPEC — sorgente e stato di analisi di una singola pagina fisica",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "page_id", "document_id", "source", "identity", "artifacts", "context", "relations", "companion_mapping", "analysis"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "page_id": {"type": "string", "pattern": ":p[0-9]{4,}$"},
    "document_id": {"type": "string", "minLength": 1},
    "companionPageCount": {"type": "integer", "minimum": 1, "maximum": 26},
    "source_warning": {"$ref": "urn:optconv:source-warning:1.0.0"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["pdf_sha256", "page_index", "physical_page_number", "pdf_label_raw", "pdf_label", "geometry"],
      "properties": {
        "pdf_sha256": {"$ref": "#/$defs/sha256"},
        "page_index": {"type": "integer", "minimum": 0},
        "physical_page_number": {"type": "integer", "minimum": 1},
        "pdf_label_raw": {"type": ["string", "null"]},
        "pdf_label": {"type": ["string", "null"]},
        "geometry": {
          "type": "object", "additionalProperties": false,
          "required": ["width_pt", "height_pt", "rotation", "cropbox", "mediabox"],
          "properties": {
            "width_pt": {"type": "number", "exclusiveMinimum": 0},
            "height_pt": {"type": "number", "exclusiveMinimum": 0},
            "rotation": {"enum": [0, 90, 180, 270]},
            "cropbox": {"$ref": "#/$defs/bbox"}, "mediabox": {"$ref": "#/$defs/bbox"}
          }
        }
      }
    },
    "identity": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "title_method", "title_confidence", "title_bbox", "printed_number_candidates", "extraction_warnings"],
      "properties": {
        "title": {"type": ["string", "null"]},
        "title_method": {"enum": ["top_lines_font_geometry", "unavailable"]},
        "title_confidence": {"$ref": "#/$defs/confidence"},
        "title_bbox": {"oneOf": [{"$ref": "#/$defs/bbox"}, {"type": "null"}]},
        "printed_number_candidates": {"type": "array", "items": {
          "type": "object", "additionalProperties": false, "required": ["number", "total", "raw", "bbox"],
          "properties": {"number": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 1},
                         "raw": {"type": "string"}, "bbox": {"$ref": "#/$defs/bbox"}}
        }},
        "extraction_warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      }
    },
    "artifacts": {
      "type": "object", "additionalProperties": false, "required": ["text", "reading_order_text", "layout", "render"],
      "properties": {
        "text": {"$ref": "#/$defs/artifact"}, "reading_order_text": {"$ref": "#/$defs/artifact"},
        "layout": {"$ref": "#/$defs/artifact"},
        "render": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256", "width_px", "height_px", "dpi", "renderer", "pixel_sha256"],
          "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"},
            "width_px": {"type": "integer", "minimum": 1}, "height_px": {"type": "integer", "minimum": 1},
            "dpi": {"type": "integer", "minimum": 72, "maximum": 300}, "renderer": {"type": "string"},
            "pixel_sha256": {"$ref": "#/$defs/sha256"}}
        }
      }
    },
    "context": {
      "type": "object", "additionalProperties": false, "required": ["previous_page_id", "next_page_id"],
      "properties": {"previous_page_id": {"type": ["string", "null"]}, "next_page_id": {"type": ["string", "null"]}}
    },
    "relations": {"type": "array", "items": {
      "type": "object", "additionalProperties": false,
      "required": ["page_id", "kind", "confidence", "review_status", "reason", "metrics", "delta_in_physical_order"],
      "properties": {
        "page_id": {"type": "string"}, "kind": {"enum": ["exact_duplicate", "near_duplicate", "progressive_candidate"]},
        "confidence": {"$ref": "#/$defs/confidence"}, "review_status": {"enum": ["verified_exact", "candidate"]},
        "reason": {"type": "string", "minLength": 1},
        "metrics": {
          "type": "object", "additionalProperties": false,
          "required": ["text_jaccard", "text_containment", "left_tokens", "right_tokens", "visual_difference", "ink_overlap", "dhash_distance"],
          "properties": {
            "text_jaccard": {"$ref": "#/$defs/confidence"}, "text_containment": {"$ref": "#/$defs/confidence"},
            "left_tokens": {"type": "integer", "minimum": 0}, "right_tokens": {"type": "integer", "minimum": 0},
            "visual_difference": {"$ref": "#/$defs/confidence"}, "ink_overlap": {"$ref": "#/$defs/confidence"},
            "dhash_distance": {"type": "integer", "minimum": 0, "maximum": 64}
          }
        },
        "delta_in_physical_order": {
          "type": "object", "additionalProperties": false, "required": ["text", "visual"],
          "properties": {
            "text": {"type": "object", "additionalProperties": false, "required": ["added_lines", "removed_lines", "semantic_interpretation"],
              "properties": {"added_lines": {"$ref": "#/$defs/strings"}, "removed_lines": {"$ref": "#/$defs/strings"},
                             "semantic_interpretation": {"const": "pending_visual_analysis"}}},
            "visual": {"type": "object", "additionalProperties": false, "required": ["changed_bbox_px"],
              "properties": {"changed_bbox_px": {"oneOf": [{"$ref": "#/$defs/bbox"}, {"type": "null"}]},
                "pixel_threshold": {"type": "integer"}, "changed_pixel_fraction": {"$ref": "#/$defs/confidence"}, "note": {"type": "string"}}}
          }
        }
      }
    }},
    "companion_mapping": {
      "type": "object", "additionalProperties": false, "required": ["default_count", "decision", "subpages", "split_rationale"],
      "properties": {"default_count": {"const": 1}, "decision": {"enum": ["pending_analysis", "proposed_after_analysis"]},
                     "subpages": {"type": "array", "maxItems": 0}, "split_rationale": {"type": "null"}}
    },
    "analysis": {
      "type": "object", "additionalProperties": false, "required": ["status", "result"],
      "properties": {"status": {"enum": ["pending", "analyzed", "needs_review"]}, "result": {"oneOf": [{"type": "null"}, {"$ref": "urn:optconv:analysis-result:1.0.0"}]}},
      "allOf": [{"if": {"properties": {"status": {"const": "pending"}}}, "then": {"properties": {"result": {"type": "null"}}},
                 "else": {"properties": {"result": {"type": "object"}}}}]
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
    "strings": {"type": "array", "items": {"type": "string"}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"],
                 "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}
  }
}
