{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:optconv:catalog:1.0.0",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "pipeline_version", "source_root", "artifact_root", "document_count", "page_count", "documents"],
  "properties": {
    "schema_version": {"const": "1.0.0"}, "pipeline_version": {"type": "string"},
    "source_root": {"type": "string", "minLength": 1}, "artifact_root": {"type": "string", "minLength": 1},
    "document_count": {"type": "integer", "minimum": 1}, "page_count": {"type": "integer", "minimum": 1},
    "documents": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["document_id", "source_path", "pdf_sha256", "page_count", "manifest_path"],
      "properties": {"document_id": {"type": "string", "minLength": 1}, "source_path": {"type": "string", "minLength": 1},
        "pdf_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "page_count": {"type": "integer", "minimum": 1},
        "manifest_path": {"type": "string", "minLength": 1}}
    }}
  }
}
